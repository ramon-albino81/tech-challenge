    {
      "name": "Gerenciamento como dono",
      "item": [
        {
          "name": "Criar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('runId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Criação retorna 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('createdUserId', body.id);",
                  "pm.environment.set('clientLogin', 'cliente.' + pm.environment.get('runId'));",
                  "pm.environment.set('clientId', body.id);",
                  "pm.test('Location aponta para o recurso criado', function () { pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/users/' + body.id); });",
                  "pm.test('Perfil não expõe senha nem hash', function () { pm.expect(body).not.to.have.property('password'); pm.expect(body).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Cliente {{runId}}\",\"email\":\"cliente.{{runId}}@example.invalid\",\"password\":\"{{clientPassword}}\",\"login\":\"cliente.{{runId}}\",\"type\":\"CLIENTE\",\"address\":{\"street\":\"Rua Postman\",\"number\":\"10\",\"city\":\"São Paulo\",\"postal_code\":\"01000-000\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            }
          }
        },
