  "item": [
    {
      "name": "Autenticação do dono",
      "item": [
        {
          "name": "Login válido - dono",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"login\":\"{{evaluationLogin}}\",\"password\":\"{{evaluationPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login retorna 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('ownerToken', body.accessToken);",
                  "const decodeBase64 = require('atob');",
                  "const ownerPayload = body.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "pm.environment.set('ownerId', JSON.parse(decodeBase64(ownerPayload.padEnd(Math.ceil(ownerPayload.length / 4) * 4, '='))).sub);",
                  "pm.test('Resposta contém bearer token e expiração', function () { pm.expect(body.tokenType).to.eql('Bearer'); pm.expect(body.expiresAt).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido",
          "request": {
            "method": "POST",
            "header": [
              {
